#!/usr/bin/env bash
#
# Code Ocean master script for the IsalSR capsule.
#
# Reproduces the artifact's verification suite: it builds the C++ engine from
# source and runs the whole test suite twice -- once on the C++ engine and once
# on the pure-Python engine -- because the paper's numbers were produced with
# the C++ engine and the two are claimed to be semantically identical.  Running
# both is what turns that claim into evidence rather than an assertion.
#
# It does NOT re-run the 12,600-run SR campaign.  That is 12 h per run on a
# cluster; see REPRODUCING.md for how to launch it.
#
set -euo pipefail

# --------------------------------------------------------------------------- #
# Locate the project root
# --------------------------------------------------------------------------- #
# Code Ocean's git import puts a repository's `code/` folder at /code and
# everything else at the capsule root.  Which of the two holds this repository
# depends on how the capsule was created, so find pyproject.toml rather than
# assume.  $PWD is /code during a Reproducible Run.
find_root() {
    local candidate
    for candidate in "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)" /code / "${PWD}"; do
        if [ -f "${candidate}/pyproject.toml" ]; then
            printf '%s\n' "${candidate}"
            return 0
        fi
    done
    echo "FATAL: no pyproject.toml found in the capsule; cannot locate IsalSR." >&2
    return 1
}

ROOT="$(find_root)"
RESULTS="${RESULTS_DIR:-/results}"
mkdir -p "${RESULTS}"
cd "${ROOT}"

echo "IsalSR capsule"
echo "  project root : ${ROOT}"
echo "  results      : ${RESULTS}"
echo "  python       : $(python -c 'import sys; print(sys.executable)')"
echo

# --------------------------------------------------------------------------- #
# Build the C++ engine
# --------------------------------------------------------------------------- #
# This is the one install that cannot happen at image-build time: the
# post-install script runs before /code is mounted.  It therefore runs here,
# with no network, which forces two flags:
#
#   --no-build-isolation  pip may not fetch scikit-build-core into a throwaway
#                         env; the pinned copy in the image is used instead.
#   --no-index            nothing may be resolved from PyPI. Every runtime
#                         dependency is already installed, hence --no-deps.
#
# Editable rather than a wheel, to match the installation the development
# workflow documents and the reported results were produced under.
echo "== building isalsr (C++ engine) =="
# scikit-build-core's build-dir is relative to the source tree.  Redirect it to
# /tmp so the build does not depend on the project root being writable, which
# differs between a Reproducible Run and a Cloud Workstation.
export SKBUILD_BUILD_DIR="${TMPDIR:-/tmp}/isalsr-build/{wheel_tag}"
python -m pip install --no-build-isolation --no-deps --no-index -e . 2>&1 \
    | tail -5

# The extension resolves from site-packages while the Python sources resolve
# from the repository, so a failed compile is invisible unless it is asserted.
python - <<'PY'
import sys
from isalsr.core import backends

info = backends.build_info()
print(f"engine: {backends.engine()}")
for key in ("build_hash", "isa_level", "compiler", "cplusplus"):
    print(f"  {key}: {info.get(key)}")
if backends.engine() != "cpp":
    print("FATAL: the C++ extension did not build; results would not be "
          "comparable to the reported ones.", file=sys.stderr)
    sys.exit(1)
PY
echo

# --------------------------------------------------------------------------- #
# Provenance
# --------------------------------------------------------------------------- #
{
    echo "# IsalSR capsule run environment"
    echo
    echo '```'
    python -c 'import sys; print("python:", sys.version)'
    python -c 'from isalsr.core import backends; import json; print("backends:", json.dumps(backends.build_info()))'
    echo "cmake:  $(cmake --version | head -1)"
    echo "gcc:    $(gcc --version | head -1)"
    echo "cpus:   $(nproc)"
    echo '```'
    echo
    echo '## Installed packages'
    echo
    echo '```'
    python -m pip freeze
    echo '```'
} > "${RESULTS}/environment.md"

# --------------------------------------------------------------------------- #
# Test suite, on both engines
# --------------------------------------------------------------------------- #
# A non-zero pytest exit must not abort the script before the reports are
# written, so each pass records its own status and the script exits on the
# aggregate at the end.
status=0

# `-m "not manuscript"` deselects the two modules that check the LaTeX
# manuscript against the code.  The manuscript is not part of this repository,
# so those tests can only skip here; deselecting them keeps the report free of
# skips that would otherwise read as untested behaviour.
run_suite() {
    local label="$1"; shift
    echo "== test suite (${label} engine) =="
    if env "$@" python -m pytest tests/ \
            -p no:cacheprovider \
            -m "not manuscript" \
            --junitxml="${RESULTS}/pytest-${label}.xml" \
            -rfEs -q \
            > "${RESULTS}/pytest-${label}.log" 2>&1; then
        echo "   PASS"
    else
        status=1
        echo "   FAIL (see ${RESULTS}/pytest-${label}.log)"
    fi
    tail -1 "${RESULTS}/pytest-${label}.log"
    echo
}

run_suite cpp    ISALSR_ENGINE=cpp
run_suite python ISALSR_ENGINE=python

# --------------------------------------------------------------------------- #
# Static analysis
# --------------------------------------------------------------------------- #
echo "== ruff =="
if python -m ruff check src/ tests/ > "${RESULTS}/ruff.log" 2>&1; then
    echo "   PASS"
else
    status=1
    echo "   FAIL (see ${RESULTS}/ruff.log)"
fi

echo "== mypy (strict) =="
if python -m mypy src/isalsr/ > "${RESULTS}/mypy.log" 2>&1; then
    echo "   PASS"
else
    status=1
    echo "   FAIL (see ${RESULTS}/mypy.log)"
fi
echo

# --------------------------------------------------------------------------- #
# Summary
# --------------------------------------------------------------------------- #
python - "${RESULTS}" <<'PY'
"""Fold the two JUnit reports into one Markdown summary."""
import pathlib
import sys
import xml.etree.ElementTree as ET

results = pathlib.Path(sys.argv[1])
rows = []
for engine in ("cpp", "python"):
    path = results / f"pytest-{engine}.xml"
    if not path.is_file():
        rows.append((engine, "—", "—", "—", "—", "—"))
        continue
    suite = ET.parse(path).getroot()
    suite = suite.find("testsuite") if suite.tag == "testsuites" else suite
    get = lambda k: int(suite.get(k, 0))  # noqa: E731
    total = get("tests")
    failures, errors, skipped = get("failures"), get("errors"), get("skipped")
    rows.append((
        engine,
        str(total),
        str(total - failures - errors - skipped),
        str(failures + errors),
        str(skipped),
        f'{float(suite.get("time", 0.0)):.1f}s',
    ))

lines = [
    "# IsalSR — verification summary",
    "",
    "The suite runs twice.  The C++ engine is the one the reported results were",
    "produced with; the pure-Python engine is the reference implementation.  Both",
    "must pass identically, which is what makes the two interchangeable.",
    "",
    "| engine | tests | passed | failed | skipped | time |",
    "|---|---:|---:|---:|---:|---:|",
]
lines += ["| " + " | ".join(r) + " |" for r in rows]
lines += ["", "Full logs: `pytest-cpp.log`, `pytest-python.log`, `ruff.log`, `mypy.log`.",
          "Environment and exact package versions: `environment.md`.", ""]
(results / "summary.md").write_text("\n".join(lines), encoding="utf-8")
print("\n".join(lines))
PY

exit "${status}"
